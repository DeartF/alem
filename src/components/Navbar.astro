---
interface Props {
  brand: string;
  links?: { text: string; href: string }[];
  ctaText?: string;
  ctaLink?: string;
}

const { brand, links = [], ctaText, ctaLink } = Astro.props;
---

<nav class="sticky top-0 z-50 bg-background/80 backdrop-blur-xl border-b border-border/50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="text-lg font-bold text-foreground tracking-tight">{brand}</a>
      <div class="hidden sm:flex sm:items-center sm:gap-x-8">
        {links.map((l) => (
          <a href={l.href} class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">
            {l.text}
          </a>
        ))}
        {ctaText && ctaLink && (
          <a
            href={ctaLink}
            class="rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground hover:opacity-90 transition-opacity"
          >
            {ctaText}
          </a>
        )}
      </div>
    </div>
  </div>
</nav>
