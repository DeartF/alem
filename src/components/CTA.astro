---
interface Props {
  heading: string;
  text: string;
  buttonText: string;
  buttonLink: string;
}

const { heading, text, buttonText, buttonLink } = Astro.props;
---

<section class="py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl rounded-3xl bg-primary px-8 py-16 text-center sm:px-16">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{heading}</h2>
      <p class="mt-4 text-lg text-white/80">{text}</p>
      <a
        href={buttonLink}
        class="mt-8 inline-block rounded-xl bg-white px-8 py-3.5 text-sm font-semibold text-primary shadow-sm hover:bg-gray-100 transition-colors"
      >
        {buttonText}
      </a>
    </div>
  </div>
</section>
