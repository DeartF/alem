---
interface Props {
  companyName: string;
  phone?: string;
  email?: string;
  address?: string;
  whatsapp?: string;
}

const { companyName, phone, email, address, whatsapp } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-foreground text-background/60">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-8">
      <div>
        <p class="text-xl font-bold text-background">{companyName}</p>
        {address && <p class="mt-2 text-sm">{address}</p>}
      </div>
      <div class="flex flex-col gap-3 text-sm">
        {phone && <a href={`tel:${phone}`} class="hover:text-background transition-colors">{phone}</a>}
        {email && <a href={`mailto:${email}`} class="hover:text-background transition-colors">{email}</a>}
        {whatsapp && (
          <a
            href={`https://wa.me/${whatsapp.replace(/\D/g, '')}`}
            class="hover:text-background transition-colors"
            target="_blank"
          >
            WhatsApp
          </a>
        )}
      </div>
    </div>
    <div class="mt-12 border-t border-background/10 pt-8 text-center text-xs text-background/40">
      &copy; {year} {companyName}
    </div>
  </div>
</footer>
