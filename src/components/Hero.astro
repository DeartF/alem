---
interface Props {
  headline: string;
  subheadline: string;
  ctaText: string;
  ctaLink: string;
  image?: string;
}

const { headline, subheadline, ctaText, ctaLink, image } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-primary/5 to-white">
  <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:flex lg:items-center lg:gap-x-16 lg:px-8">
    <div class="mx-auto max-w-2xl lg:mx-0 lg:flex-auto">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
        {headline}
      </h1>
      <p class="mt-6 text-lg leading-8 text-gray-600">
        {subheadline}
      </p>
      <div class="mt-10 flex items-center gap-x-6">
        <a
          href={ctaLink}
          class="rounded-xl bg-primary px-6 py-3.5 text-sm font-semibold text-white shadow-sm hover:bg-primary-dark transition-colors"
        >
          {ctaText}
        </a>
      </div>
    </div>
    {image && (
      <div class="mt-16 sm:mt-24 lg:mt-0 lg:flex-shrink-0">
        <img
          src={image}
          alt=""
          class="w-full max-w-lg rounded-2xl shadow-2xl"
        />
      </div>
    )}
  </div>
</section>
