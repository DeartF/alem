---
interface Props {
  heading: string;
  text: string;
  image?: string;
  stats?: { value: string; label: string }[];
}

const { heading, text, image, stats } = Astro.props;
---

<section class="py-24 sm:py-32 bg-gray-50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-none lg:grid lg:grid-cols-2 lg:gap-x-16 lg:items-center">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">{heading}</h2>
        <p class="mt-6 text-lg leading-8 text-gray-600">{text}</p>
        {stats && stats.length > 0 && (
          <dl class="mt-10 grid grid-cols-2 gap-8">
            {stats.map((s) => (
              <div>
                <dt class="text-sm text-gray-500">{s.label}</dt>
                <dd class="mt-1 text-3xl font-bold text-primary">{s.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
      {image && (
        <div class="mt-10 lg:mt-0">
          <img src={image} alt="" class="w-full rounded-2xl shadow-lg" />
        </div>
      )}
    </div>
  </div>
</section>
