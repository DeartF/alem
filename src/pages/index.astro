---
import Base from '../layouts/Base.astro';
---

<Base
  title="Арзан Alem — скачай приложение"
  description="Продукты онлайн для дома и бизнеса. Скачайте приложение Арзан Alem в один клик."
>
  <main class="relative min-h-screen overflow-hidden bg-[#f0f2f8] text-[#0a1744] selection:bg-[#0f1d5b]/20">

    <!-- Background -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -right-32 -top-32 h-[500px] w-[500px] rounded-full bg-[#0f1d5b]/8 blur-[120px]"></div>
      <div class="absolute -left-20 bottom-[-10%] h-[400px] w-[400px] rounded-full bg-[#f5c518]/10 blur-[100px]"></div>
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27n%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.65%27 numOctaves=%274%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23n)%27/%3E%3C/svg%3E'); background-size: 200px;"></div>
    </div>

    <!-- Content -->
    <section class="relative mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center px-5 py-12 text-center sm:px-8">

      <!-- Logo badge -->
      <div class="hero-el mb-8 inline-flex items-center gap-3 rounded-full border border-[#0f1d5b]/12 bg-white/70 py-2 pl-2 pr-5 shadow-[0_4px_24px_rgba(15,29,91,0.06)] backdrop-blur-sm" style="--d:0s">
        <img src="/alem/avatar.png" alt="Арзан Alem" class="h-10 w-10 rounded-full object-cover" />
        <span class="text-sm font-semibold tracking-wide text-[#0f1d5b]" style="font-family: 'Plus Jakarta Sans', sans-serif;">Арзан Alem</span>
      </div>

      <!-- Headline -->
      <h1 class="hero-el text-[clamp(32px,7vw,64px)] font-extrabold leading-[1.05] tracking-[-0.04em]" style="font-family: 'Plus Jakarta Sans', sans-serif; --d:.08s">
        Продукты для дома<br class="hidden sm:block" />
        и бизнеса — <span class="bg-gradient-to-r from-[#0f1d5b] to-[#1a3a8f] bg-clip-text text-transparent">в один клик</span>
      </h1>

      <!-- Subtitle -->
      <p class="hero-el mt-5 max-w-lg text-base leading-relaxed text-[#0a1744]/60 sm:text-lg sm:leading-relaxed" style="font-family: 'Plus Jakarta Sans', sans-serif; --d:.16s">
        Широкий ассортимент, быстрая доставка и лучшие цены.<br class="hidden sm:block" />
        Установите приложение и начните экономить.
      </p>

      <!-- Features chips -->
      <div class="hero-el mt-8 flex flex-wrap justify-center gap-2.5" style="--d:.24s">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white/80 px-4 py-2 text-xs font-medium text-[#0f1d5b] shadow-sm ring-1 ring-[#0f1d5b]/10 backdrop-blur-sm">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          Быстрая доставка
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white/80 px-4 py-2 text-xs font-medium text-[#0f1d5b] shadow-sm ring-1 ring-[#0f1d5b]/10 backdrop-blur-sm">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          Лучшие цены
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white/80 px-4 py-2 text-xs font-medium text-[#0f1d5b] shadow-sm ring-1 ring-[#0f1d5b]/10 backdrop-blur-sm">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v3"/></svg>
          Для бизнеса и дома
        </span>
      </div>

      <!-- CTA Buttons — hidden form trick for FB Pixel Lead event -->
      <div class="hero-el mt-10 flex w-full max-w-md flex-col gap-3 sm:flex-row sm:gap-4" style="--d:.32s">

        <!-- App Store button (hidden form) -->
        <form
          id="form-appstore"
          class="group relative flex-1"
          onsubmit="return handleStoreClick(event, 'appstore')"
        >
          <input type="hidden" name="platform" value="ios" />
          <input type="hidden" name="app" value="arzan-alem" />
          <input type="hidden" name="source" value="landing" />
          <button type="submit" class="flex w-full items-center justify-center gap-3 rounded-2xl bg-[#0f1d5b] px-6 py-4 text-white shadow-[0_8px_32px_rgba(15,29,91,0.2)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#0a1744] hover:shadow-[0_12px_40px_rgba(15,29,91,0.3)] active:scale-[0.98]">
            <svg class="h-7 w-7 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            <span class="text-left">
              <span class="block text-[10px] font-medium leading-none opacity-70">Скачать в</span>
              <span class="block text-base font-bold leading-tight" style="font-family: 'Space Grotesk', sans-serif;">App Store</span>
            </span>
          </button>
        </form>

        <!-- Google Play button (hidden form) -->
        <form
          id="form-googleplay"
          class="group relative flex-1"
          onsubmit="return handleStoreClick(event, 'googleplay')"
        >
          <input type="hidden" name="platform" value="android" />
          <input type="hidden" name="app" value="arzan-alem" />
          <input type="hidden" name="source" value="landing" />
          <button type="submit" class="flex w-full items-center justify-center gap-3 rounded-2xl bg-[#f5c518] px-6 py-4 text-[#0a1744] shadow-[0_8px_32px_rgba(245,197,24,0.25)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#ffd233] hover:shadow-[0_12px_40px_rgba(245,197,24,0.35)] active:scale-[0.98]">
            <svg class="h-7 w-7 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.18 2.04c-.2.18-.18.5-.18.84v18.24c0 .34-.02.66.18.84l.05.04L13.8 12.44v-.28L3.23 2.59l-.05-.04v.49z"/>
              <path d="M17.34 16l-3.54-3.56v-.28L17.34 8.6l.08.04 4.2 2.38c1.2.68 1.2 1.8 0 2.48l-4.2 2.38-.08.12z"/>
              <path d="M17.42 15.88L13.8 12.24 3.18 22.12c.4.42 1.04.46 1.78.06l12.46-6.3z"/>
              <path d="M17.42 8.72L4.96 2.42C4.22 2.02 3.58 2.06 3.18 2.48L13.8 12.36l3.62-3.64z"/>
            </svg>
            <span class="text-left">
              <span class="block text-[10px] font-medium leading-none opacity-70">Доступно в</span>
              <span class="block text-base font-bold leading-tight" style="font-family: 'Space Grotesk', sans-serif;">Google Play</span>
            </span>
          </button>
        </form>
      </div>

      <!-- Trust line -->
      <p class="hero-el mt-6 text-xs text-[#0a1744]/40" style="--d:.4s">
        Бесплатно · iOS и Android · Более 100 установок
      </p>

    </section>
  </main>

  <!-- Hero animation -->
  <style>
    .hero-el {
      opacity: 0;
      transform: translateY(24px);
      animation: heroFadeIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: var(--d, 0s);
    }
    @keyframes heroFadeIn {
      to { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-el { animation: none; opacity: 1; transform: none; }
    }
  </style>

  <!-- Form submit → Pixel Lead → redirect to store -->
  <script is:inline>
    function handleStoreClick(e, platform) {
      e.preventDefault();

      if (typeof fbq === 'function') {
        fbq('track', 'Lead', {
          content_name: 'app_install_click',
          content_category: platform === 'appstore' ? 'ios' : 'android'
        });
      }

      var url = platform === 'appstore'
        ? 'https://apps.apple.com/kz/app/%D0%B0%D1%80%D0%B7%D0%B0%D0%BD-alem/id6757691588'
        : 'https://play.google.com/store/apps/details?id=arzanalem.evomall';

      setTimeout(function() {
        window.open(url, '_blank');
      }, 300);

      return false;
    }
  </script>
</Base>
